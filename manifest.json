{
  "name": "pulse",
  "title": "Pulse",
  "description": "A corporate blog platform for YouTrack: write, read, and discuss articles in one place.",
  "$schema": "https://json.schemastore.org/youtrack-app.json",
  "version": "1.0.0",
  "url": "https://youtrack.fans/pulse",
  "minYouTrackVersion": "2026.3.0",
  "changeNotes": "Initial release.",
  "vendor": {
    "name": "YouTrack Fans",
