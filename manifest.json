    "email": "support@youtrack.fans"
  },
  "icon": "icons/blog-icon-nav.svg",
  "widgets": [
    {
      "key": "feed",
      "name": "Pulse",
      "indexPath": "feed/index.html",
      "extensionPoint": "MAIN_MENU_ITEM",
      "iconPath": "feed/widget-icon-nav.svg",
      "description": "Corporate blog powered by YouTrack Articles",
      "showHeader": false,
      "loaderMode": "none",
      "permissions": [
        "READ_ARTICLE"
      ]
    }
  ]
