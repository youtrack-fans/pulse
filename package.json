{
  "name": "pulse",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run clean && npm run build:backend && npm run dev:upload && vite",
    "dev:upload": "npm run build:backend && npm run build:frontend && npm run upload-local",
    "build:backend": "vite -c vite.config.backend.ts build",
    "build:frontend": "vite build",
    "build": "npm run clean && npm run build:backend && tsc -p tsconfig.app.json && npm run build:frontend && youtrack-app app validate",
    "clean": "rm -f src/api/api.d.ts src/api/api.zod.ts",
    "watch": "vite -c vite.config.backend.ts build --watch --mode development",
    "update": "npm run build && npm run upload-local",
    "upload-local": "set -a && source .env && set +a && youtrack-app app upload --host $YOUTRACK_HOST --token $YOUTRACK_TOKEN",
    "generate": "npx @jetbrains/create-youtrack-app",
    "g": "npm run generate --",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run --project unit --project dom",
    "pack": "rm -rf pulse.zip && cd dist/ && bestzip ../pulse.zip *",
    "upload": "youtrack-app app upload",
    "test:bundle": "npm run build && vitest run --project bundle"
  },
  "dependencies": {
    "@jetbrains/icons": "^5.16.0",
    "@jetbrains/ring-ui-built": "^7.0.91",
    "@jetbrains/youtrack-workflow-types": "^2026.2.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.1",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.13.0",
    "@jetbrains/eslint-config": "^6.0.2",
    "@jetbrains/youtrack-apps-tools": "^1.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "bestzip": "^2.2.1",
    "eslint": "^9.13.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^15.11.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "ts-to-zod": "^3.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.1",
    "vite": "^6.0.1",
    "vite-plugin-static-copy": "^2.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  }
}
